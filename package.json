{
  "name": "@zeeshanjamshed/ai-workflow-kit",
  "version": "0.4.6",
  "description": "Approval-first CLI for setting up shared project rules, onboarding skills, and handoffs for coding agents.",
  "author": "Zeeshan Jamshed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeshanjamshed/ai-workflow-kit.git"
  },
  "homepage": "https://github.com/zeeshanjamshed/ai-workflow-kit#readme",
  "bugs": {
    "url": "https://github.com/zeeshanjamshed/ai-workflow-kit/issues"
  },
  "keywords": [
    "ai-workflow",
    "coding-agents",
    "cli",
    "project-setup",
    "claude-code",
    "codex",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "ai-setup": "node packages/cli/src/main.ts",
    "test": "node --test packages/cli/tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test:package": "node packages/cli/tests/package-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "assets:check": "node scripts/assets.mjs check",
    "assets:freeze": "node scripts/assets.mjs freeze",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run assets:check",
    "package:check": "node scripts/package.mjs",
    "test:artifact": "node scripts/smoke-artifact.mjs",
    "verify": "npm run check && npm test && npm run build && npm run package:check && npm run test:artifact",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:publish": "node scripts/release-publish.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "semver": "7.8.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  },
  "bin": {
    "ai-setup": "dist/packages/cli/src/main.js"
  },
  "files": [
    "dist/packages/cli/src",
    "docs/CLI_REFERENCE.md",
    "docs/AGENT_LAUNCH.md",
    "docs/TRIALS.md",
    "assets",
    "CHANGELOG.md"
  ]
}
