{
  "name": "@zeeshanjamshed/ai-workflow-kit",
  "version": "0.4.2",
  "description": "Approval-first CLI for setting up shared project rules, onboarding skills, and handoffs for coding agents.",
  "author": "Zeeshan Jamshed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeeshanjamshed/ai-workflow-kit.git"
  },
  "homepage": "https://github.com/zeeshanjamshed/ai-workflow-kit#readme",
  "bugs": {
    "url": "https://github.com/zeeshanjamshed/ai-workflow-kit/issues"
  },
  "keywords": [
    "ai-workflow",
    "coding-agents",
    "cli",
    "project-setup",
    "claude-code",
    "codex",
    "cursor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "ai-setup": "node packages/cli/src/main.ts",
    "test": "node --test packages/cli/tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test:package": "node packages/cli/tests/package-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "bin": {
    "ai-setup": "dist/packages/cli/src/main.js"
  },
  "files": [
    "dist/packages/cli/src"
  ]
}
